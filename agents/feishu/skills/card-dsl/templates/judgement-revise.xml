<!--
  判断卡 · 改判卡(海豚三号判断卡流程第 3 步,mentor 改判时发)
  values:title(如"✏️ 改判 · 写下你的判断")/ original(海豚原判断段,可含分数星)/
    hint(填写提示,如"请按锐评三要写下你的判断…")/
    placeholder(输入框占位,默认"你的判断(一句话,可含分数)")/ record_id
  context(注入回调 value):case_id / case_kind / person_open_id / mentor_open_id /
    comment_value(输入框初始文本)
  输入动作:judge_revise_input(comment 默认映射可覆盖),由调用方经
  handler_overrides_json 映射到直调工具;输入框确认按钮文案为「提交改判」。
-->
<card title="{title}" template="blue">
  <text value="{original}"/>
  <text value="{hint}"/>
  <comment placeholder="{placeholder}" bind-record="{record_id}" action="judge_revise_input"
           confirm-title="提交改判" confirm-text="按你的判断改判这条记录？"/>
</card>

      "forbid_any": ["必须先交方案", "不写方案就不能", "必须先写 RFC", "必须先写技术方案"]
    },
    {
      "id": "A-N3",
      "session": "A-N3",
      "required": true,
      "user": "我自己那份周报草稿段落有点乱，就我自己看的，也不涉及别人的 TODO。你帮我把「本周进展 / 下周计划 / 风险」三块顺序理顺，文案紧一点。",
      "expect_any_of": [
        ["本周", "下周", "进展", "计划", "风险", "周报"]
      ],
      "forbid_any": ["中事", "技术方案", "RFC", "多方案评审", "先写方案"]

      "expect_any_of": [
        ["缺", "不够", "太空", "动机", "场景", "痛点", "备选", "风险", "对比", "对象"]
      ],
      "forbid_any": ["挺好的可以去讲", "已经够拿得出手"]
    },
    {
      "id": "B-N2",

    {
      "id": "A-N6",
      "session": "A-N6",
      "required": true,
      "user": "下周三到周五我要去客户现场，得请假，回来还要报差旅大概八百。流程上我先找谁、卡片怎么填你还记得吗？",
      "expect_any_of": [
        ["请假", "假勤", "差旅", "报销", "行政"]
      ],
      "forbid_any": ["先写技术方案", "先写 RFC", "这是中事", "这是大事", "多方案评审"]

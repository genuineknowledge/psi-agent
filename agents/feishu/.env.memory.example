# Copy to .env.memory and fill in the operator-provisioned values.
# Do not commit a real .env.memory file.
#
# FUSION_MEMORY_AUTO_REGISTER_FEISHU is the one that must not be left unset:
# its default is False (tools/_fusion_memory_config.py), and with a token map
# configured, any open_id missing from that map then raises
# memory_user_not_configured instead of being registered on first use — the
# user chats normally but nothing reaches durable memory. Deployments that
# onboard Feishu users continuously want this on.

FUSION_MEMORY_MCP_URL=https://memory.example.com/mcp
FUSION_MEMORY_AUTO_REGISTER_FEISHU=1
FUSION_MEMORY_ORGANIZATION_ID=org_example

# Automatic registration signs a short-lived assertion with the Feishu app
# secret, so both of these are required whenever it is enabled.
PSI_FEISHU_APP_ID=cli_xxx
PSI_FEISHU_APP_SECRET=your_feishu_app_secret

# Optional override; default: {AppData}/fusion-memory/tokens.json
# Keep the map outside this workspace and outside source control.
FUSION_MEMORY_TOKEN_MAP_FILE=/absolute/path/to/memory_tokens.json
